		{
			"name": "[concat(parameters('factoryName'), '/pl_ecom_ingest_products_api')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "REST API -> Bronze. Pagination rule on the skip query parameter; nested products[] array flattened via collectionReference.",
				"activities": [
					{
						"name": "copy_products_api",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.02:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "RestSource",
								"additionalColumns": [
									{
										"name": "_ingest_ts",
										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										}
									}
								],
								"httpRequestTimeout": "00:01:40",
								"requestInterval": "00.00:00:00.010",
								"requestMethod": "GET",
								"paginationRules": {
									"QueryParameters.skip": "RANGE:0:600:30",
									"EndCondition:$.products": "Empty"
								}
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"path": "[['id']"
										},
										"sink": {
											"name": "product_id",
											"type": "Int32"
										}
									},
									{
										"source": {
											"path": "[['title']"
										},
										"sink": {
											"name": "title",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['category']"
										},
										"sink": {
											"name": "category",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['brand']"
										},
										"sink": {
											"name": "brand",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['price']"
										},
										"sink": {
											"name": "list_price",
											"type": "Decimal"
										}
									},
									{
										"source": {
											"path": "[['discountPercentage']"
										},
										"sink": {
											"name": "discount_pct",
											"type": "Decimal"
										}
									},
									{
										"source": {
											"path": "[['rating']"
										},
										"sink": {
											"name": "rating",
											"type": "Decimal"
										}
									},
									{
										"source": {
											"path": "[['stock']"
										},
										"sink": {
											"name": "api_stock",
											"type": "Int32"
										}
									},
									{
										"source": {
											"path": "[['sku']"
										},
										"sink": {
											"name": "sku",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['availabilityStatus']"
										},
										"sink": {
											"name": "availability_status",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['returnPolicy']"
										},
										"sink": {
											"name": "return_policy",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['_ingest_ts']"
										},
										"sink": {
											"name": "_ingest_ts",
											"type": "String"
										}
									}
								],
								"collectionReference": "$['products']",
								"mapComplexValuesToString": true
							}
						},
						"inputs": [
							{
								"referenceName": "ds_rest_dummyjson",
								"type": "DatasetReference",
								"parameters": {
									"relative_url": "products?limit=30"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference",
								"parameters": {
									"container": "bronzefinserve",
									"folder_path": {
										"value": "@concat('ecom/products/load_date=', formatDateTime(pipeline().TriggerTime,'yyyy-MM-dd'))",
										"type": "Expression"
									},
									"file_name": {
										"value": "@concat('products_', pipeline().RunId, '.parquet')",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"folder": {
					"name": "ecom"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_rest_dummyjson')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ecom_ingest_table_cdc')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "CDC ingestion for one table; watermark stored in ops/cdc/ecom/<table>.json; supports back-dated refresh.",
				"activities": [
					{
						"name": "gm_cdc_file",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.02:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_adls_json",
								"type": "DatasetReference",
								"parameters": {
									"container": "opsfinserve",
									"folder_path": "cdc/ecom",
									"file_name": {
										"value": "@concat(pipeline().parameters.table_name, '.json')",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"exists"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": false,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "JsonReadSettings"
							}
						}
					},
					{
						"name": "if_cdc_file_exists",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "gm_cdc_file",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@activity('gm_cdc_file').output.exists",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "set_from_default",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_from",
										"value": "1900-01-01 00:00:00.000"
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "lkp_cdc_file",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.02:00:00",
										"retry": 1,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "JsonSource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "JsonReadSettings"
											}
										},
										"dataset": {
											"referenceName": "ds_adls_json",
											"type": "DatasetReference",
											"parameters": {
												"container": "opsfinserve",
												"folder_path": "cdc/ecom",
												"file_name": {
													"value": "@concat(pipeline().parameters.table_name, '.json')",
													"type": "Expression"
												}
											}
										},
										"firstRowOnly": true
									}
								},
								{
									"name": "set_from_cdc_file",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "lkp_cdc_file",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_from",
										"value": {
											"value": "@activity('lkp_cdc_file').output.firstRow.cdc_ts",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "set_effective_from",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "if_cdc_file_exists",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_effective_from",
							"value": {
								"value": "@if(empty(pipeline().parameters.backdate), variables('v_from'), pipeline().parameters.backdate)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "lkp_max_cdc",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "set_effective_from",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.02:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat('SELECT CONVERT(VARCHAR(23), MAX(', pipeline().parameters.watermark_column, '), 121) AS max_ts, COUNT_BIG(1) AS delta_rows FROM ecom.', pipeline().parameters.table_name, ' WHERE ', pipeline().parameters.watermark_column, ' > ''', variables('v_effective_from'), '''')",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_generic",
								"type": "DatasetReference",
								"parameters": {
									"schema_name": "ctl",
									"table_name": "ingestion_config"
								}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "if_new_data",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "lkp_max_cdc",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('lkp_max_cdc').output.firstRow.delta_rows, 0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "copy_to_bronze",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.02:00:00",
										"retry": 1,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"additionalColumns": [
												{
													"name": "_adf_run_id",
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													}
												},
												{
													"name": "_ingest_ts",
													"value": {
														"value": "@utcNow()",
														"type": "Expression"
													}
												}
											],
											"sqlReaderQuery": {
												"value": "@concat('SELECT * FROM ecom.', pipeline().parameters.table_name, ' WHERE ', pipeline().parameters.watermark_column, ' > ''', variables('v_effective_from'), ''' AND ', pipeline().parameters.watermark_column, ' <= ''', activity('lkp_max_cdc').output.firstRow.max_ts, '''')",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_sql_generic",
											"type": "DatasetReference",
											"parameters": {
												"schema_name": "ecom",
												"table_name": {
													"value": "@pipeline().parameters.table_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_parquet",
											"type": "DatasetReference",
											"parameters": {
												"container": "bronzefinserve",
												"folder_path": {
													"value": "@concat('ecom/', pipeline().parameters.table_name, '/load_date=', formatDateTime(pipeline().TriggerTime,'yyyy-MM-dd'))",
													"type": "Expression"
												},
												"file_name": {
													"value": "@concat(pipeline().parameters.table_name, '_', formatDateTime(utcNow(),'yyyyMMddHHmmss'), '.parquet')",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "copy_update_cdc_file",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "copy_to_bronze",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.02:00:00",
										"retry": 1,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat('SELECT ''', activity('lkp_max_cdc').output.firstRow.max_ts, ''' AS cdc_ts, ''', pipeline().RunId, ''' AS updated_by_run')",
												"type": "Expression"
											},
											"queryTimeout": "00:10:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings",
												"filePattern": "setOfObjects"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_sql_generic",
											"type": "DatasetReference",
											"parameters": {
												"schema_name": "ecom",
												"table_name": {
													"value": "@pipeline().parameters.table_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_json",
											"type": "DatasetReference",
											"parameters": {
												"container": "opsfinserve",
												"folder_path": "cdc/ecom",
												"file_name": {
													"value": "@concat(pipeline().parameters.table_name, '.json')",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string"
					},
					"watermark_column": {
						"type": "string",
						"defaultValue": "updated_at"
					},
					"backdate": {
						"type": "string"
					}
				},
				"variables": {
					"v_from": {
						"type": "String"
					},
					"v_effective_from": {
						"type": "String"
					}
				},
				"folder": {
					"name": "ecom"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls_json')]",
				"[concat(variables('factoryId'), '/datasets/ds_sql_generic')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]"
			]
		}
	]
}