		"ls_prac_azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-finserve-rohit.database.windows.net"
		},
		"ls_prac_azuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-finserve-rohit"
		},
		"ls_onprem_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost\\SQLEXPRESS"
		},
		"ls_onprem_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "CoreBankingDB"
		},
		"ls_onprem_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_reader"
		}
	},
