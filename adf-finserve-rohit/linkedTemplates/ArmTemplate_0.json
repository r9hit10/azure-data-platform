					"authentication": "MSI",
					"workspaceResourceId": "/subscriptions/251d6b7f-bfbb-4f42-b69b-eca2405b7121/resourceGroups/rg-finserve-dev/providers/Microsoft.Databricks/workspaces/dbw-finserve-dev",
					"newClusterNodeType": "Standard_DS3_v2",
					"newClusterNumOfWorker": "1",
					"newClusterVersion": "15.4.x-photon-scala2.12",
					"clusterOption": "Fixed",
					"newClusterInitScripts": []
