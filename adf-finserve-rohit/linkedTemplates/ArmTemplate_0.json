{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-finserve-rohit"
		},
		"ls_onprem_sqlserver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_onprem_sqlserver'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfinservedevrohit.dfs.core.windows.net/"
		},
		"ls_azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-finserve-rohit.database.windows.net"
		},
		"ls_azuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-finserve-rohit"
		},
		"ls_prac_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfinservedevrohit.dfs.core.windows.net/"
		},
		"ls_rest_crm_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dummyjson.com/"
		},
		"ls_rest_dummyjson_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dummyjson.com/"
		},
		"ls_onprem_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost\\SQLEXPRESS"
		},
		"ls_onprem_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "CoreBankingDB"
		},
		"ls_onprem_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_reader"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_send_alert')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Posts a failure payload to a Logic App HTTP trigger, which emails you.",
				"activities": [
					{
						"name": "if_alert_url_set",
						"type": "IfCondition",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(empty(pipeline().parameters.logic_app_url))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "web_call_logic_app",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.02:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "POST",
										"headers": {
											"Content-Type": "application/json"
										},
										"url": {
											"value": "@pipeline().parameters.logic_app_url",
											"type": "Expression"
										},
										"body": {
											"value": "@json(concat('{\"pipeline\":\"', pipeline().parameters.failed_pipeline, '\",\"run_id\":\"', pipeline().parameters.failed_run_id, '\",\"factory\":\"', pipeline().DataFactory, '\",\"message\":\"', replace(pipeline().parameters.message, '\"', ''''), '\"}'))",
											"type": "Expression"
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"logic_app_url": {
						"type": "string"
					},
					"failed_pipeline": {
						"type": "string"
					},
					"failed_run_id": {
						"type": "string"
					},
					"message": {
						"type": "string",
						"defaultValue": "Pipeline failed"
					}
				},
				"folder": {
					"name": "00_framework"
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
