		"ls_azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-finserve-rohit.database.windows.net"
		},
		"ls_azuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-finserve-rohit"
		},
		"ls_prac_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfinservedevrohit.dfs.core.windows.net/"
