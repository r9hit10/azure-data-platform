			"type": "string",
			"defaultValue": "https://dummyjson.com/"
		},
		"ls_rest_dummyjson_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dummyjson.com/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_send_alert')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Posts a failure payload to a Logic App HTTP trigger, which emails you.",
				"activities": [
					{
						"name": "if_alert_url_set",
						"type": "IfCondition",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(empty(pipeline().parameters.logic_app_url))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "web_call_logic_app",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.02:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "POST",
										"headers": {
											"Content-Type": "application/json"
										},
										"url": {
											"value": "@pipeline().parameters.logic_app_url",
											"type": "Expression"
										},
										"body": {
											"value": "@json(concat('{\"pipeline\":\"', pipeline().parameters.failed_pipeline, '\",\"run_id\":\"', pipeline().parameters.failed_run_id, '\",\"factory\":\"', pipeline().DataFactory, '\",\"message\":\"', replace(pipeline().parameters.message, '\"', ''''), '\"}'))",
											"type": "Expression"
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"logic_app_url": {
						"type": "string"
					},
					"failed_pipeline": {
						"type": "string"
					},
					"failed_run_id": {
						"type": "string"
					},
					"message": {
						"type": "string",
						"defaultValue": "Pipeline failed"
					}
				},
				"folder": {
					"name": "00_framework"
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls1_ansh_dl')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
