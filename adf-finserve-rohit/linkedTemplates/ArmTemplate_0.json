	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-finserve-rohit"
		},
		"ls1_ansh_dl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfinservedevrohit.dfs.core.windows.net/"
		},
		"ls_02_source_git_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfinservedevrohit.dfs.core.windows.net/"
		},
		"ls_azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-finserve-rohit.database.windows.net"
		},
		"ls_azuresql_properties_typeProperties_database": {
			"type": "string",
