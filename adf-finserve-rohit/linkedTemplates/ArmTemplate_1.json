		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_05_source_dataflow_reportinng",
								"type": "DatasetReference"
							},
							"name": "sourcereporting"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds05_sink_dataflow",
								"type": "DatasetReference"
							},
							"name": "sinktransformedfiles"
						}
					],
					"transformations": [
						{
							"name": "selectcols"
						},
						{
							"name": "filterRows"
						},
						{
							"name": "splitpayments",
							"description": "Add cases to distribute the data in multiple groups/"
						},
						{
							"name": "derivedColumnRemoveNulls"
						}
					],
					"scriptLines": [
						"source(output(",
						"          transaction_id as short,",
						"          transactional_date as timestamp,",
						"          product_id as string,",
						"          customer_id as short,",
						"          payment as string,",
						"          credit_card as long,",
						"          loyalty_card as boolean,",
						"          cost as double,",
						"          quantity as short,",
						"          price as double",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourcereporting",
						"sourcereporting select(mapColumn(",
						"          transaction_id,",
						"          transactional_date,",
						"          product_id,",
						"          customer_id,",
						"          payment,",
						"          cost,",
						"          quantity,",
						"          price",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcols",
						"selectcols filter(customer_id !=  12) ~> filterRows",
						"filterRows split(payment=='visa',",
						"     payment=='americanexpress',",
						"     disjoint: false) ~> splitpayments@(visa, americanexpress, neitherboth)",
						"splitpayments@neitherboth derive(payment = coalesce(payment,'N/A')) ~> derivedColumnRemoveNulls",
						"splitpayments@visa sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinktransformedfiles"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_05_source_dataflow_reportinng')]"
			]
		}
	]
