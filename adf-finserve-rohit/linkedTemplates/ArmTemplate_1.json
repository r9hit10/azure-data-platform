		{
			"name": "[concat(parameters('factoryName'), '/pl_ecom_ingest_products_api')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "REST API -> Bronze. Pagination rule on the skip query parameter; nested products[] array flattened via collectionReference.",
				"activities": [
					{
						"name": "copy_products_api",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.02:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "RestSource",
								"additionalColumns": [
									{
										"name": "_ingest_ts",
										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										}
									}
								],
								"httpRequestTimeout": "00:01:40",
								"requestInterval": "00.00:00:00.010",
								"requestMethod": "GET",
								"paginationRules": {
									"QueryParameters.skip": "RANGE:0:600:30",
									"EndCondition:$.products": "Empty"
								}
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"path": "[['id']"
										},
										"sink": {
											"name": "product_id",
											"type": "Int32"
										}
									},
									{
										"source": {
											"path": "[['title']"
										},
										"sink": {
											"name": "title",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['category']"
										},
										"sink": {
											"name": "category",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['brand']"
										},
										"sink": {
											"name": "brand",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['price']"
										},
										"sink": {
											"name": "list_price",
											"type": "Decimal"
										}
									},
									{
										"source": {
											"path": "[['discountPercentage']"
										},
										"sink": {
											"name": "discount_pct",
											"type": "Decimal"
										}
									},
									{
										"source": {
											"path": "[['rating']"
										},
										"sink": {
											"name": "rating",
											"type": "Decimal"
										}
									},
									{
										"source": {
											"path": "[['stock']"
										},
										"sink": {
											"name": "api_stock",
											"type": "Int32"
										}
									},
									{
										"source": {
											"path": "[['sku']"
										},
										"sink": {
											"name": "sku",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['availabilityStatus']"
										},
										"sink": {
											"name": "availability_status",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "[['returnPolicy']"
										},
										"sink": {
											"name": "return_policy",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['_ingest_ts']"
										},
										"sink": {
											"name": "_ingest_ts",
											"type": "String"
										}
									}
								],
								"collectionReference": "$['products']",
								"mapComplexValuesToString": true
							}
						},
						"inputs": [
							{
								"referenceName": "ds_rest_dummyjson",
								"type": "DatasetReference",
								"parameters": {
									"relative_url": "products?limit=30"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_adls_parquet",
								"type": "DatasetReference",
								"parameters": {
									"container": "bronzefinserve",
									"folder_path": {
										"value": "@concat('ecom/products/load_date=', formatDateTime(pipeline().TriggerTime,'yyyy-MM-dd'))",
										"type": "Expression"
									},
									"file_name": {
										"value": "@concat('products_', pipeline().RunId, '.parquet')",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"folder": {
					"name": "ecom"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_rest_dummyjson')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]"
			]
		}
	]
