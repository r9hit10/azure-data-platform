{
    "name": "pl_ingest_api_resource",
    "properties": {
        "description": "CHILD: incremental REST ingestion - meta call for the new watermark, then paged copy (AbsoluteUrl pagination) of the window.",
        "activities": [
            {
                "name": "sp_log_start",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "storedProcedureName": "[ctl].[usp_log_run_start]",
                    "storedProcedureParameters": {
                        "pipeline_run_id": {
                            "value": {
                                "value": "@pipeline().RunId",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "parent_run_id": {
                            "value": {
                                "value": "@pipeline().parameters.parent_run_id",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pipeline_name": {
                            "value": {
                                "value": "@pipeline().Pipeline",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "project": {
                            "value": {
                                "value": "@pipeline().parameters.project",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "source_table": {
                            "value": {
                                "value": "@concat(pipeline().parameters.source_schema, '.', pipeline().parameters.source_table)",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "old_watermark": {
                            "value": {
                                "value": "@pipeline().parameters.last_watermark",
                                "type": "Expression"
                            },
                            "type": "String"
                        }
                    }
                },
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "linkedServiceName": {
                    "referenceName": "ls_azuresql",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "lkp_api_meta",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "sp_log_start",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "RestSource",
                        "httpRequestTimeout": "00:02:00",
                        "requestInterval": "00.00:00:00.010",
                        "requestMethod": "GET"
                    },
                    "dataset": {
                        "referenceName": "ds_rest_crm_api",
                        "type": "DatasetReference",
                        "parameters": {
                            "relative_url": {
                                "value": "@concat(pipeline().parameters.source_table, '/meta?modified_since=', encodeUriComponent(pipeline().parameters.last_watermark))",
                                "type": "Expression"
                            }
                        }
                    },
                    "firstRowOnly": true
                },
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                }
            },
            {
                "name": "if_has_new_data",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "lkp_api_meta",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@greater(activity('lkp_api_meta').output.firstRow.record_count, 0)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "copy_api_to_bronze",
                            "type": "Copy",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "RestSource",
                                    "httpRequestTimeout": "00:02:00",
                                    "requestInterval": "00.00:00:00.010",
                                    "requestMethod": "GET",
                                    "paginationRules": {
                                        "AbsoluteUrl": "$.next_page"
                                    }
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "mappings": [
                                        {
                                            "source": {
                                                "path": "['CustomerID']"
                                            },
                                            "sink": {
                                                "name": "CustomerID",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['FirstName']"
                                            },
                                            "sink": {
                                                "name": "FirstName",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['LastName']"
                                            },
                                            "sink": {
                                                "name": "LastName",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['Email']"
                                            },
                                            "sink": {
                                                "name": "Email",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['Phone']"
                                            },
                                            "sink": {
                                                "name": "Phone",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['City']"
                                            },
                                            "sink": {
                                                "name": "City",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['State']"
                                            },
                                            "sink": {
                                                "name": "State",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['CreatedDate']"
                                            },
                                            "sink": {
                                                "name": "CreatedDate",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['ModifiedDate']"
                                            },
                                            "sink": {
                                                "name": "ModifiedDate",
                                                "type": "String"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['Status']"
                                            },
                                            "sink": {
                                                "name": "Status",
                                                "type": "String"
                                            }
                                        }
                                    ],
                                    "collectionReference": "$['data']"
                                }
                            },
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 1,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_rest_crm_api",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "relative_url": {
                                            "value": "@concat(pipeline().parameters.source_table, '?modified_since=', encodeUriComponent(pipeline().parameters.last_watermark), '&modified_until=', encodeUriComponent(activity('lkp_api_meta').output.firstRow.max_modified), '&page_size=5000')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_adls_parquet",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.target_container",
                                            "type": "Expression"
                                        },
                                        "folder_path": {
                                            "value": "@concat(pipeline().parameters.target_folder, '/load_date=', formatDateTime(pipeline().TriggerTime,'yyyy-MM-dd'))",
                                            "type": "Expression"
                                        },
                                        "file_name": {
                                            "value": "@concat(pipeline().parameters.source_table, '_', pipeline().RunId, '.parquet')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "sp_update_watermark",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "copy_api_to_bronze",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_update_watermark]",
                                "storedProcedureParameters": {
                                    "config_id": {
                                        "value": {
                                            "value": "@pipeline().parameters.config_id",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    },
                                    "new_watermark": {
                                        "value": {
                                            "value": "@activity('lkp_api_meta').output.firstRow.max_modified",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_azuresql",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "sp_log_success",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "sp_update_watermark",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_log_run_end]",
                                "storedProcedureParameters": {
                                    "pipeline_run_id": {
                                        "value": {
                                            "value": "@pipeline().RunId",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "source_table": {
                                        "value": {
                                            "value": "@concat(pipeline().parameters.source_schema, '.', pipeline().parameters.source_table)",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "status": {
                                        "value": "SUCCEEDED",
                                        "type": "String"
                                    },
                                    "rows_read": {
                                        "value": {
                                            "value": "@activity('copy_api_to_bronze').output.rowsRead",
                                            "type": "Expression"
                                        },
                                        "type": "Int64"
                                    },
                                    "rows_copied": {
                                        "value": {
                                            "value": "@activity('copy_api_to_bronze').output.rowsCopied",
                                            "type": "Expression"
                                        },
                                        "type": "Int64"
                                    },
                                    "new_watermark": {
                                        "value": {
                                            "value": "@activity('lkp_api_meta').output.firstRow.max_modified",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "file_path": {
                                        "value": {
                                            "value": "@concat(pipeline().parameters.target_container, '/', concat(pipeline().parameters.target_folder, '/load_date=', formatDateTime(pipeline().TriggerTime,'yyyy-MM-dd')), '/', concat(pipeline().parameters.source_table, '_', pipeline().RunId, '.parquet'))",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_azuresql",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "sp_log_copy_failure",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "copy_api_to_bronze",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_log_run_end]",
                                "storedProcedureParameters": {
                                    "pipeline_run_id": {
                                        "value": {
                                            "value": "@pipeline().RunId",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "source_table": {
                                        "value": {
                                            "value": "@concat(pipeline().parameters.source_schema, '.', pipeline().parameters.source_table)",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "status": {
                                        "value": "FAILED",
                                        "type": "String"
                                    },
                                    "error_message": {
                                        "value": {
                                            "value": "@activity('copy_api_to_bronze').error.message",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_azuresql",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "fail_copy",
                            "type": "Fail",
                            "dependsOn": [
                                {
                                    "activity": "sp_log_copy_failure",
                                    "dependencyConditions": [
                                        "Completed"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "message": {
                                    "value": "@concat('Copy failed for ', concat(pipeline().parameters.source_schema, '.', pipeline().parameters.source_table), ': ', activity('copy_api_to_bronze').error.message)",
                                    "type": "Expression"
                                },
                                "errorCode": "500"
                            }
                        }
                    ],
                    "ifFalseActivities": [
                        {
                            "name": "sp_log_no_new_data",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_log_run_end]",
                                "storedProcedureParameters": {
                                    "pipeline_run_id": {
                                        "value": {
                                            "value": "@pipeline().RunId",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "source_table": {
                                        "value": {
                                            "value": "@concat(pipeline().parameters.source_schema, '.', pipeline().parameters.source_table)",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "status": {
                                        "value": "NO_NEW_DATA",
                                        "type": "String"
                                    },
                                    "rows_read": {
                                        "value": 0,
                                        "type": "Int64"
                                    },
                                    "rows_copied": {
                                        "value": 0,
                                        "type": "Int64"
                                    },
                                    "new_watermark": {
                                        "value": {
                                            "value": "@pipeline().parameters.last_watermark",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_azuresql",
                                "type": "LinkedServiceReference"
                            }
                        }
                    ]
                }
            },
            {
                "name": "sp_log_lkp_api_meta_failure",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "lkp_api_meta",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "storedProcedureName": "[ctl].[usp_log_run_end]",
                    "storedProcedureParameters": {
                        "pipeline_run_id": {
                            "value": {
                                "value": "@pipeline().RunId",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "source_table": {
                            "value": {
                                "value": "@concat(pipeline().parameters.source_schema, '.', pipeline().parameters.source_table)",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "status": {
                            "value": "FAILED",
                            "type": "String"
                        },
                        "error_message": {
                            "value": {
                                "value": "@activity('lkp_api_meta').error.message",
                                "type": "Expression"
                            },
                            "type": "String"
                        }
                    }
                },
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "linkedServiceName": {
                    "referenceName": "ls_azuresql",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "fail_lkp_api_meta",
                "type": "Fail",
                "dependsOn": [
                    {
                        "activity": "sp_log_lkp_api_meta_failure",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "message": {
                        "value": "@concat('lkp_api_meta failed for ', concat(pipeline().parameters.source_schema, '.', pipeline().parameters.source_table))",
                        "type": "Expression"
                    },
                    "errorCode": "500"
                }
            }
        ],
        "parameters": {
            "config_id": {
                "type": "int"
            },
            "project": {
                "type": "string"
            },
            "source_schema": {
                "type": "string"
            },
            "source_table": {
                "type": "string"
            },
            "load_type": {
                "type": "string",
                "defaultValue": "INCREMENTAL"
            },
            "watermark_column": {
                "type": "string",
                "defaultValue": ""
            },
            "last_watermark": {
                "type": "string",
                "defaultValue": "1900-01-01 00:00:00.000"
            },
            "target_container": {
                "type": "string",
                "defaultValue": "bronzefinserve"
            },
            "target_folder": {
                "type": "string"
            },
            "parent_run_id": {
                "type": "string",
                "defaultValue": ""
            }
        },
        "variables": {},
        "annotations": [],
        "folder": {
            "name": "00_framework"
        }
    }
}