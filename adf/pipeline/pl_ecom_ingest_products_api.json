{
	"name": "pl_ecom_ingest_products_api",
	"properties": {
		"description": "REST API -> Bronze. Pagination rule on the skip query parameter; nested products[] array flattened via collectionReference.",
		"activities": [
			{
				"name": "copy_products_api",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"additionalColumns": [
							{
								"name": "_ingest_ts",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						],
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"QueryParameters.skip": "RANGE:0:600:30",
							"EndCondition:$.products": "Empty"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false
				}
			}
		],
		"folder": {
			"name": "ecom"
		},
		"annotations": []
	}
}