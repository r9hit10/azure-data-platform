{
	"name": "pl_ecom_ingest_table_cdc",
	"properties": {
		"description": "CDC ingestion for one table; watermark stored in ops/cdc/ecom/<table>.json; supports back-dated refresh.",
		"activities": [
			{
				"name": "gm_cdc_file",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": false,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "if_cdc_file_exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "gm_cdc_file",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('gm_cdc_file').output.exists",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "set_from_default",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_from",
								"value": "1900-01-01 00:00:00.000"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "lkp_cdc_file",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.02:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": false,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "set_from_cdc_file",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "lkp_cdc_file",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_from",
								"value": {
									"value": "@activity('lkp_cdc_file').output.firstRow.cdc_ts",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "set_effective_from",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "if_cdc_file_exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_effective_from",
					"value": {
						"value": "@if(empty(pipeline().parameters.backdate), variables('v_from'), pipeline().parameters.backdate)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "lkp_max_cdc",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "set_effective_from",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT CONVERT(VARCHAR(23), MAX(', pipeline().parameters.watermark_column, '), 121) AS max_ts, COUNT_BIG(1) AS delta_rows FROM ecom.', pipeline().parameters.table_name, ' WHERE ', pipeline().parameters.watermark_column, ' > ''', variables('v_effective_from'), '''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "if_new_data",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "lkp_max_cdc",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('lkp_max_cdc').output.firstRow.delta_rows, 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "copy_to_bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.02:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"additionalColumns": [
										{
											"name": "_adf_run_id",
											"value": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											}
										},
										{
											"name": "_ingest_ts",
											"value": {
												"value": "@utcNow()",
												"type": "Expression"
											}
										}
									],
									"sqlReaderQuery": {
										"value": "@concat('SELECT * FROM ecom.', pipeline().parameters.table_name, ' WHERE ', pipeline().parameters.watermark_column, ' > ''', variables('v_effective_from'), ''' AND ', pipeline().parameters.watermark_column, ' <= ''', activity('lkp_max_cdc').output.firstRow.max_ts, '''')",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false
							}
						},
						{
							"name": "copy_update_cdc_file",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "copy_to_bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.02:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT ''', activity('lkp_max_cdc').output.firstRow.max_ts, ''' AS cdc_ts, ''', pipeline().RunId, ''' AS updated_by_run')",
										"type": "Expression"
									},
									"queryTimeout": "00:10:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings",
										"filePattern": "setOfObjects"
									}
								},
								"enableStaging": false
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_name": {
				"type": "string"
			},
			"watermark_column": {
				"type": "string",
				"defaultValue": "updated_at"
			},
			"backdate": {
				"type": "string"
			}
		},
		"variables": {
			"v_from": {
				"type": "String"
			},
			"v_effective_from": {
				"type": "String"
			}
		},
		"folder": {
			"name": "ecom"
		},
		"annotations": []
	}
}